# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Search grounding is free only on the 2.5 Flash family
RESEARCH_MODEL=gemini-2.5-flash
AGENT_MODEL=gemini-3.5-flash

# Session 2, only if you use CrewAI: stops a 20-second pause asking about traces
CREWAI_TRACING_ENABLED=false
# Session 2, only if you use CrewAI: true prints each agent's steps (CrewAI verbose mode)
VERBOSE=true
